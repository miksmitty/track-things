{
  "title": "Use Case",
  "levels": [
    {
      "title": "Use Case",
      "columns": [
        {
          "key": "name",
          "label": "Title",
          "type": "text",
          "look": "plain",
          "agg": "count"
        },
        {
          "key": "status",
          "label": "Lifecycle",
          "type": "choice",
          "options": [
            "Stage 1",
            "Stage 2",
            "Stage 3",
            "Stage 4"
          ],
          "colors": {
            "Stage 1": "gray",
            "Stage 2": "green",
            "Stage 3": "teal",
            "Stage 4": "teal"
          },
          "agg": "count"
        },
        {
          "key": "owner",
          "label": "Owner",
          "type": "person"
        },
        {
          "key": "due",
          "label": "Due",
          "type": "date"
        },
        {
          "key": "done",
          "label": "Done",
          "type": "checkbox",
          "agg": "count"
        },
        {
          "key": "kjkj",
          "label": "kjkj",
          "type": "number",
          "agg": "sum"
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "choice",
          "options": [
            "Urgent",
            "Backend",
            "Frontend",
            "Docs"
          ],
          "colors": {
            "Backend": "teal",
            "Docs": "blue"
          },
          "multi": true
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "notes"
        },
        {
          "key": "vendor",
          "label": "Vendor",
          "type": "lookup",
          "set": "vendors",
          "show": [
            "category",
            "name"
          ]
        }
      ],
      "rules": [
        {
          "name": "Done",
          "when": [
            {
              "col": "status",
              "op": "is",
              "value": "Complete"
            }
          ],
          "effect": {
            "apply": "row",
            "tone": "",
            "label": "",
            "done": true
          }
        },
        {
          "name": "Overdue",
          "when": [
            {
              "col": "due",
              "op": "past"
            },
            {
              "col": "status",
              "op": "isNot",
              "value": "Complete"
            }
          ],
          "effect": {
            "apply": "due",
            "tone": "red",
            "label": "OVERDUE",
            "done": true
          }
        }
      ]
    },
    {
      "title": "Meeting",
      "columns": [
        {
          "key": "item",
          "label": "Title",
          "type": "text",
          "look": "plain"
        },
        {
          "key": "qty",
          "label": "Attendees",
          "type": "text",
          "look": "plain"
        },
        {
          "key": "meeting_date",
          "label": "Meeting Date",
          "type": "date"
        }
      ],
      "rules": []
    }
  ]
}